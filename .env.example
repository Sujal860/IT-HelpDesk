# Local demo uses SQLite. Set DB_MODE=mysql to connect to your MySQL server.
DB_MODE=sqlite
SQLITE_PATH=helpdesk_demo.db

# Change both values before using this application on a shared network.
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_PASSWORD=change-this-admin-password
FLASK_DEBUG=0
COOKIE_SECURE=0
PORT=5000

# MySQL settings (used only when DB_MODE=mysql)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=YOUR_MYSQL_PASSWORD
MYSQL_DATABASE=helpdesk_db

# Optional C++ compiler override; otherwise g++ or clang++ is detected.
# CXX=g++
